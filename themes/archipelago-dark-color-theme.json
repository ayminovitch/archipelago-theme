    "button.secondaryForeground": "#DFE1E5",
    "button.secondaryHoverBackground": "#393B40",
    "keybindingLabel.background": "#393B40",
    "keybindingLabel.border": "#4E5157",
    "gitDecoration.modifiedResourceForeground": "#70AEFF",
    "gitDecoration.addedResourceForeground": "#73BD79",
    "gitDecoration.untrackedResourceForeground": "#D5756C",
    "gitDecoration.deletedResourceForeground": "#868A91",
    "gitDecoration.ignoredResourceForeground": "#B39A62",
    "gitDecoration.conflictingResourceForeground": "#DE6A66",
    "gitDecoration.submoduleResourceForeground": "#8C8F96"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#BCBEC4",
        "background": "#191A1C"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7A7E85",
        "fontStyle": ""
      }
    },
    {
      "name": "Docstrings",
      "scope": [
        "string.quoted.docstring",
        "string.quoted.docstring.multi.python",
        "string.quoted.docstring.single.python",
        "punctuation.definition.string.begin.python.docstring",
        "punctuation.definition.string.end.python.docstring"
      ],
      "settings": {
        "foreground": "#5F826B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#6AAB73"
      }
    },
    {
      "name": "Escapes, f-string braces, string prefixes",
      "scope": [
        "constant.character.escape",
        "constant.character.format.placeholder",
        "constant.character.format.placeholder.other.python",
        "storage.type.string.python",
        "meta.fstring.python punctuation.definition",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#CF8E6D"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#2AACB8"
      }
    },
    {
      "name": "Keywords (incl. import/control flow, True/False/None)",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "constant.language",
        "keyword.operator.logical.python",
        "keyword.operator.expression",
        "keyword.operator.new",
        "keyword.operator.word",
        "support.type.primitive",
        "variable.language.this",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#CF8E6D",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "name": "Plain identifiers, types and classes (PyCharm keeps them default)",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "meta.definition.variable",
        "entity.name.variable",
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "support.type.python",
        "entity.name.namespace",
        "meta.function-call.generic",
        "meta.function-call entity.name.function",
        "support.variable",
        "meta.attribute",
        "variable.other.object",
        "variable.other.readwrite",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "name": "Function definitions",
      "scope": [
        "entity.name.function",
        "meta.function entity.name.function",
        "meta.definition.function entity.name.function",
        "meta.definition.method entity.name.function"
      ],
      "settings": {
        "foreground": "#56A8F5"
      }
    },
    {
      "name": "Function calls stay default",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.generic.python",
        "support.function"
      ],
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "name": "Built-in functions",
      "scope": [
        "support.function.builtin",
        "support.function.builtin.python"
      ],
      "settings": {
        "foreground": "#8888C6"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.function.decorator",
        "meta.function.decorator.python",
        "entity.name.function.decorator",
        "entity.name.function.decorator.python",
        "punctuation.definition.decorator",
        "meta.decorator",
        "meta.decorator entity.name.function",
        "meta.decorator punctuation.decorator"
      ],
      "settings": {
        "foreground": "#B3AE60"
      }
    },
    {
      "name": "Decorator arguments stay normal",
      "scope": [
        "meta.function.decorator meta.function-call.arguments",
        "meta.function.decorator.python meta.function-call.arguments.python"
      ],
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "name": "Keyword arguments",
      "scope": [
        "variable.parameter.function-call.python",
        "meta.function-call.arguments variable.parameter.function-call"
      ],
      "settings": {
        "foreground": "#AA4926"
      }
    },
    {
      "name": "self / cls",
      "scope": [
        "variable.language.special.self",
        "variable.language.special.self.python",
        "variable.parameter.function.language.special.self",
        "variable.parameter.function.language.special.self.python",
        "variable.language.special.cls",
        "variable.language.special.cls.python",
        "variable.parameter.function.language.special.cls",
        "variable.parameter.function.language.special.cls.python"
      ],
      "settings": {
        "foreground": "#94558D"
      }
    },
    {
      "name": "Dunder methods and names",
      "scope": [
        "support.function.magic",
        "support.function.magic.python",
        "support.variable.magic",
        "support.variable.magic.python"
      ],
      "settings": {
        "foreground": "#B200B2"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "variable.other.constant",
        "constant.other",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#C77DBB"
      }
    },
    {
      "name": "Type hints in comments",
      "scope": [
        "comment.typehint",
        "comment.typehint.type.notation"
      ],
      "settings": {
        "foreground": "#7A7E85"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.character.class.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#42C3D4"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F75464"
      }
    },
    {
      "name": "JSON / JS object keys",
      "scope": [
        "support.type.property-name",
        "support.type.property-name.json",
        "meta.object-literal.key",
        "meta.structure.dictionary.key.python"
      ],
      "settings": {
        "foreground": "#C77DBB"
      }
    },
    {
      "name": "YAML keys",
      "scope": [
        "entity.name.tag.yaml",
        "punctuation.definition.anchor.yaml"
      ],
      "settings": {
        "foreground": "#CF8E6D"
      }
    },
    {
      "name": "TOML keys and tables",
      "scope": [
        "support.type.property-name.toml",
        "variable.other.key.toml",
        "support.type.property-name.table.toml",
        "entity.other.attribute-name.table.toml",
        "entity.other.attribute-name.table.array.toml"
      ],
      "settings": {
        "foreground": "#CF8E6D"
      }
    },
    {
      "name": "Env files",
      "scope": [
        "variable.other.env",
        "variable.key.dotenv",
        "variable.other.dotenv"
      ],
      "settings": {
        "foreground": "#C77DBB"
      }
    },
    {
      "name": "Shell variables",
      "scope": [
        "variable.other.normal.shell",
        "punctuation.definition.variable.shell",
        "variable.other.positional.shell",
        "variable.other.special.shell"
      ],
      "settings": {
        "foreground": "#C77DBB"
      }
    },
    {
      "name": "HTML / XML tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#D5B778"
      }
    },
    {
      "name": "HTML attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "markup.heading punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#CF8E6D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#6AAB73"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link"
      ],
      "settings": {
        "foreground": "#548AF7"
      }
    },
    {
      "name": "Markdown lists and quotes",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "markup.quote"
      ],
      "settings": {
        "foreground": "#CF8E6D"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#73BD79"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#F75464"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#70AEFF"
      }
    }
  ]
}
