    "editorOverviewRuler.border": "#00000000",
    "editorError.foreground": "#F75464",
    "editorWarning.foreground": "#F2C55C",
    "editorInfo.foreground": "#548AF7",
    "editorHint.foreground": "#868A91",
    "editorUnnecessaryCode.opacity": "#000000AA",
    "editorGutter.modifiedBackground": "#375FAD",
    "editorGutter.addedBackground": "#549159",
    "editorGutter.deletedBackground": "#868A91",
    "editorStickyScroll.background": "#191A1C",
    "editorStickyScrollHover.background": "#232428",
    "diffEditor.insertedTextBackground": "#29443699",
    "diffEditor.removedTextBackground": "#5E383899",
